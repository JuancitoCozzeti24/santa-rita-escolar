{
  "manifest_version": 3,
  "name": "SieRoom Classroom Bridge",
  "version": "0.7.16",
  "description": "Puente local de SieRoom para leer y publicar comentarios privados de Classroom, con cola segura y recuperación de trabajos.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://classroom.google.com/*",
    "https://santa-rita-escolar-tcpb.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://classroom.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SieRoom Classroom Bridge",
    "default_popup": "popup.html"
  }
}
