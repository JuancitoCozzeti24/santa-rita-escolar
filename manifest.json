{
  "manifest_version": 3,
  "name": "SieRoom Classroom Bridge",
  "version": "0.8.7",
  "description": "SieRoom R6: limpieza de comentarios duplicados alumno por alumno en una sola pasada, más lectura, calificación y devolución seguras.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://classroom.google.com/*",
    "https://santa-rita-escolar-tcpb.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://classroom.google.com/*"
      ],
      "js": [
        "content.js",
        "delete_private_comment.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SieRoom Classroom Bridge",
    "default_popup": "popup.html"
  },
  "version_name": "0.8.7-HF4-GRADE-TARGET-DEDUP-SINGLE-PASS-R6"
}
