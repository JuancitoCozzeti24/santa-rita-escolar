{
  "manifest_version": 3,
  "name": "SieRoom Classroom Bridge",
  "version": "0.8.7",
  "description": "Puente local SieRoom con cuenta docente y entrega destino verificadas para leer, publicar o eliminar comentarios privados, calificar y devolver en Classroom.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://classroom.google.com/*",
    "https://santa-rita-escolar-tcpb.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://classroom.google.com/*"
      ],
      "js": [
        "content.js",
        "delete_private_comment.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SieRoom Classroom Bridge",
    "default_popup": "popup.html"
  },
  "version_name": "0.8.7-HF4-GRADE-TARGET-DEDUP-TEST-R3-R3"
}
