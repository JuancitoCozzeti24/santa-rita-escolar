rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() {
      return signedIn() && request.auth.token.email == "profejohnnyb@gmail.com";
    }

    match /roster/{studentId} {
      allow read: if signedIn();
      allow update: if signedIn()
        && resource.data.active == true
        && (!("claimedUid" in resource.data) || resource.data.claimedUid == request.auth.uid)
        && request.resource.data.claimedUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["claimedUid", "claimedAt"]);
      allow create, delete: if owner();
    }

    match /profiles/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || owner());
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.bestScore == 0
        && request.resource.data.plays == 0
        && (
          (owner()
            && request.resource.data.rosterId == "OWNER"
            && request.resource.data.publicName == "Profe Johnny"
            && request.resource.data.section in ["2A", "2B", "5A", "5B"])
          ||
          (request.resource.data.rosterId == "PUBLIC"
            && request.resource.data.section == "LIBRE"
            && request.resource.data.publicName is string
            && request.resource.data.publicName.size() > 0
            && request.resource.data.publicName.size() <= 40)
          ||
          (getAfter(/databases/$(database)/documents/roster/$(request.resource.data.rosterId)).data.claimedUid == uid
            && request.resource.data.publicName == getAfter(/databases/$(database)/documents/roster/$(request.resource.data.rosterId)).data.publicName
            && request.resource.data.section == getAfter(/databases/$(database)/documents/roster/$(request.resource.data.rosterId)).data.section)
        );
      allow update: if signedIn() && uid == request.auth.uid;
      allow delete: if owner();
    }

    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.uid == uid
        && request.resource.data.publicName == get(/databases/$(database)/documents/profiles/$(uid)).data.publicName
        && request.resource.data.section == get(/databases/$(database)/documents/profiles/$(uid)).data.section;
      allow delete: if owner();
    }

    match /scoreSubmissions/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/scoreSubmissions/$(submissionId));
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if owner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
